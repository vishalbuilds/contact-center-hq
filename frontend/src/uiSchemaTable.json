[
  {
    "id": "initialConfig",
    "title": "Initial Config",
    "tableName": "CCaaS-initial-config",
    "description": "Table for initial configuration",
    "primaryKey": "dins",
    "fields": [
      {
        "id": "dins",
        "description": "primary identifier for the config record",
        "type": "string",
        "title": "DINS",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "login",
        "description": "user login id",
        "type": "string",
        "title": "Phone number",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "defaultLanguage",
        "description": "default language for the user session",
        "type": "dropdown",
        "title": "Default language",
        "required": true,
        "defaultValue": "",
        "options": ["", "es-es", "en-in", "en-us"]
      },
      {
        "id": "AgentArn",
        "description": "Amazon resource name of the agent",
        "type": "string",
        "title": "Agent arn",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "lob",
        "description": "line of business the agent belongs to",
        "type": "dropdown",
        "title": "Line of business",
        "defaultValue": "Agent",
        "options": ["aa", "bb", "c1", "rd"]
      },
      {
        "id": "enableRecording",
        "description": "enable or disable call recording for this user",
        "type": "boolean",
        "title": "recording enabled",
        "defaultValue": "False"
      },
      {
        "id": "timezone",
        "description": "user's timezone",
        "type": "string",
        "title": "Timezone",
        "defaultValue": "UTC"
      },
      {
        "id": "shift",
        "description": "user's work shift",
        "type": "dropdown",
        "title": "Shift",
        "defaultValue": "Day",
        "options": ["Day", "Night", "Swing"]
      },
      {
        "id": "supervisor",
        "description": "supervisor name",
        "type": "string",
        "title": "Supervisor",
        "defaultValue": ""
      },
      {
        "id": "team",
        "description": "team name",
        "type": "string",
        "title": "Team",
        "defaultValue": ""
      },
      {
        "id": "location",
        "description": "work location",
        "type": "string",
        "title": "Location",
        "defaultValue": "Remote"
      },
      {
        "id": "employmentType",
        "description": "type of employment",
        "type": "dropdown",
        "title": "Employment Type",
        "defaultValue": "Full-Time",
        "options": ["Full-Time", "Part-Time", "Contractor"]
      },
      {
        "id": "hireDate",
        "description": "date of hire",
        "type": "string",
        "title": "Hire Date",
        "defaultValue": "2020-01-01"
      },
      {
        "id": "lastLogin",
        "description": "last login timestamp",
        "type": "string",
        "title": "Last Login",
        "defaultValue": ""
      },
      {
        "id": "status",
        "description": "current status",
        "type": "dropdown",
        "title": "Status",
        "defaultValue": "Active",
        "options": ["Active", "Inactive", "Suspended"]
      },
      {
        "id": "notes",
        "description": "additional notes",
        "type": "string",
        "title": "Notes",
        "defaultValue": ""
      }
    ]
  },

  {
    "id": "userDDMapping",
    "title": "User DID Mapping",
    "tableName": "CCaaS-user-did-mapping",
    "description": "Table for did configuration",
    "primaryKey": "DID",
    "fields": [
      {
        "id": "DID",
        "description": "direct inward dial number assigned to the agent",
        "type": "string",
        "title": "DID (Direct Inward Dial)",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "loginId",
        "description": "unique login identifier of the agent",
        "type": "string",
        "title": "LoginId",
        "defaultValue": ""
      },
      {
        "id": "AgentFirstName",
        "description": "first name of the agent",
        "type": "string",
        "title": "Agent First Name",
        "defaultValue": ""
      },
      {
        "id": "AgentLastName",
        "description": "last name of the agent",
        "type": "string",
        "title": "Agent Last Name",
        "defaultValue": ""
      },
      {
        "id": "extension",
        "description": "internal phone extension number",
        "type": "string",
        "title": "Extension",
        "defaultValue": ""
      },
      {
        "id": "queue",
        "description": "call queue the agent is assigned to",
        "type": "dropdown",
        "title": "Queue",
        "defaultValue": ""
      },
      {
        "id": "VoiceMail",
        "description": "voicemail box number linked to this agent",
        "type": "string",
        "title": "VoiceMail",
        "defaultValue": ""
      },
      {
        "id": "onLeave",
        "description": "indicates if the agent is on extended leave",
        "type": "boolean",
        "title": "user long leave",
        "defaultValue": "False",
        "depends": ["extendLeaveVoicemail"]
      },
      {
        "id": "extendLeaveVoicemail",
        "description": "voicemail to play when agent is on extended leave",
        "type": "string",
        "title": "voicemail for extend leave",
        "defaultValue": ""
      },
      {
        "id": "department",
        "description": "department name",
        "type": "string",
        "title": "Department",
        "defaultValue": "Support"
      },
      {
        "id": "role",
        "description": "user role",
        "type": "dropdown",
        "title": "Role",
        "defaultValue": "Agent",
        "options": ["Agent", "Supervisor", "Admin"]
      },
      {
        "id": "language",
        "description": "preferred language",
        "type": "dropdown",
        "title": "Language",
        "defaultValue": "en-us",
        "options": ["en-us", "es-es", "fr-fr"]
      },
      {
        "id": "skills",
        "description": "comma-separated skills",
        "type": "string",
        "title": "Skills",
        "defaultValue": ""
      },
      {
        "id": "manager",
        "description": "manager name",
        "type": "string",
        "title": "Manager",
        "defaultValue": ""
      },
      {
        "id": "region",
        "description": "region of operation",
        "type": "string",
        "title": "Region",
        "defaultValue": "NA"
      },
      {
        "id": "active",
        "description": "is user active",
        "type": "boolean",
        "title": "Active",
        "defaultValue": "True"
      },
      {
        "id": "createdAt",
        "description": "record creation date",
        "type": "string",
        "title": "Created At",
        "defaultValue": "2022-01-01"
      },
      {
        "id": "updatedAt",
        "description": "last update date",
        "type": "string",
        "title": "Updated At",
        "defaultValue": "2022-06-01"
      },
      {
        "id": "customField1",
        "description": "custom field 1",
        "type": "string",
        "title": "Custom Field 1",
        "defaultValue": ""
      }
    ]
  },

  {
    "id": "voicemailAccess",
    "title": "Voicemail Access",
    "tableName": "CCaaS-voicemail-access",
    "description": "Table for voicemail configuration",
    "primaryKey": "mailBoxNumber",
    "fields": [
      {
        "id": "mailBoxNumber",
        "description": "unique identifier for the voicemail mailbox",
        "type": "string",
        "title": "mailBoxNumber",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "email",
        "description": "agent email address for voicemail notifications",
        "type": "string",
        "title": "Agent email",
        "defaultValue": ""
      },
      {
        "id": "firstTimeLogin",
        "description": "flag to prompt pin change on first login",
        "type": "boolean",
        "title": "first time login",
        "defaultValue": "False"
      },
      {
        "id": "pinCode",
        "description": "default pin code to access the voicemail box",
        "type": "string",
        "title": "voicemail box pin code",
        "defaultValue": "1234"
      },
      {
        "id": "pin",
        "description": "current user-set pin for voicemail access",
        "type": "string",
        "title": "PIN",
        "defaultValue": ""
      }
    ]
  },

  {
    "id": "outboundMapping",
    "title": "Outbound Mapping",
    "tableName": "CCaaS-outbound-mapping",
    "description": "Table for outbound configuration",
    "primaryKey": "QueueArn",
    "fields": [
      {
        "id": "QueueArn",
        "description": "Amazon resource name of the queue",
        "type": "string",
        "title": "QueueArn",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "arnType",
        "description": "type of resource the ARN refers to",
        "type": "dropdown",
        "title": "arn Type",
        "defaultValue": "",
        "options": ["Queue", "Agent"]
      },
      {
        "id": "PrdCallerIdTFN",
        "description": "toll-free number displayed as caller ID for outbound calls",
        "type": "string",
        "title": "Caller ID number",
        "defaultValue": ""
      },
      {
        "id": "QueueName",
        "description": "human-readable name of the outbound queue",
        "type": "string",
        "title": "Queue name",
        "defaultValue": ""
      }
    ]
  }
]
